* text eol=lf

# Denote all files that are truly binary and should not be modified.
# Anything omitted here gets line-ending normalisation applied to it, which
# silently corrupts binaries — it cost this repo 3 bytes of the resume PDF and
# 1 byte of the hero photo before these entries were added.
*.ttf binary
*.otf binary
*.eot binary
*.woff binary
*.woff2 binary

*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.JPG binary
*.JPEG binary
*.gif binary
*.ico binary
*.bmp binary

*.pdf binary
*.zip binary
*.bin binary
*.glb binary
